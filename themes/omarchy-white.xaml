<!--
  ============================================================================
  Theme: Omarchy White
  ============================================================================
  Lấy cảm hứng từ theme "White" của Omarchy (https://omarchy.org).
  Bảng màu gốc: github.com/basecamp/omarchy/blob/master/themes/white/colors.toml

    background  #ffffff   foreground  #000000   accent  #6e6e6e
    thang xám   #1a1a1a  #2a2a2a  #2e2e2e  #3a3a3a  #3e3e3e  #4a4a4a  #c0c0c0
    selection   nền #1a1a1a / chữ #ffffff

  Nguyên tắc thiết kế (mô phỏng desktop Hyprland của Omarchy):
    1. Đơn sắc tuyệt đối: chỉ dùng đen, trắng và thang xám ở trên.
       Ngoại lệ duy nhất là #E6E6E6 (hover nút tiêu đề), một sắc độ nhạt
       suy ra từ #c0c0c0 để hover không quá gắt trên nền trắng.
    2. Tiling: mỗi vùng (sidebar, editor, terminal) là một "ô cửa sổ" có
       khe hở (TileGap) và viền 2px (TileBorder), góc vuông (Radius = 0).
    3. Thanh trên cùng kiểu Waybar: số workspace 1-4 (ô vuông đặc = trang
       đang mở), đồng hồ ở giữa. Activity bar kiểu VS Code bị ẩn.
    4. Thanh trạng thái kiểu statusline Neovim: khối đen chữ trắng ("NORMAL").

  File này CHỈ chứa token (màu, kích thước, hiển thị), không chứa layout.
  Danh sách key bắt buộc: xem themes/README.md (winutil.ps1 kiểm tra khi nạp).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ── Nền các vùng ─────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Bg"            Color="#FFFFFF"/>  <!-- editor, terminal -->
  <SolidColorBrush x:Key="BgSide"        Color="#FFFFFF"/>  <!-- sidebar -->
  <SolidColorBrush x:Key="BgTitle"       Color="#FFFFFF"/>  <!-- thanh trên (Waybar) -->
  <SolidColorBrush x:Key="BgActivity"    Color="#FFFFFF"/>  <!-- activity bar (đang ẩn) -->
  <SolidColorBrush x:Key="BgInput"       Color="#FFFFFF"/>  <!-- ô tìm kiếm -->
  <SolidColorBrush x:Key="BgTabBar"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgTabActive"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF"/>  <!-- hộp nhóm, giống box của btop -->

  <!-- ── Chữ ──────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Fg"            Color="#000000"/>
  <SolidColorBrush x:Key="FgMuted"       Color="#6E6E6E"/>  <!-- accent của Omarchy White -->
  <SolidColorBrush x:Key="FgSubtle"      Color="#6E6E6E"/>  <!-- mô tả dưới checkbox -->
  <SolidColorBrush x:Key="FgStrong"      Color="#000000"/>
  <SolidColorBrush x:Key="FgHead"        Color="#000000"/>  <!-- tiêu đề sidebar -->
  <SolidColorBrush x:Key="CommentFg"     Color="#6E6E6E"/>  <!-- "// Browsers" -->

  <!-- ── Viền ─────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Border"          Color="#3A3A3A"/>  <!-- viền hộp (btop cpu_box) -->
  <SolidColorBrush x:Key="TileBorderBrush" Color="#C0C0C0"/>  <!-- viền ô cửa sổ Hyprland -->
  <SolidColorBrush x:Key="InputBorder"     Color="#3A3A3A"/>
  <SolidColorBrush x:Key="WindowBorder"    Color="#C0C0C0"/>

  <!-- ── Điểm nhấn ────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="Accent"          Color="#1A1A1A"/>  <!-- checkbox đã chọn, focus -->
  <SolidColorBrush x:Key="AccentFg"        Color="#FFFFFF"/>  <!-- dấu tick -->
  <SolidColorBrush x:Key="TabActiveBorder" Color="#000000"/>
  <SolidColorBrush x:Key="TitleIconFg"     Color="#000000"/>
  <SolidColorBrush x:Key="TabIconFg"       Color="#000000"/>
  <SolidColorBrush x:Key="ActFg"           Color="#6E6E6E"/>
  <SolidColorBrush x:Key="ActFgActive"     Color="#000000"/>

  <!-- ── Nút: thường = viền đen nền trắng, chính = khối đen (đảo màu) ─ -->
  <SolidColorBrush x:Key="BtnBg"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BtnFg"         Color="#000000"/>
  <SolidColorBrush x:Key="BtnBorder"     Color="#3A3A3A"/>
  <SolidColorBrush x:Key="BtnPrimaryBg"  Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BtnPrimaryFg"  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BtnDangerBg"   Color="#4A4A4A"/>  <!-- slot color3 (cảnh báo) của palette -->
  <SolidColorBrush x:Key="BtnDangerFg"   Color="#FFFFFF"/>

  <!-- ── Nút tiêu đề (thu nhỏ / phóng to / đóng / đổi theme) ──────── -->
  <SolidColorBrush x:Key="CapFg"         Color="#000000"/>
  <SolidColorBrush x:Key="CapHoverBg"    Color="#E6E6E6"/>
  <SolidColorBrush x:Key="CloseHoverBg"  Color="#1A1A1A"/>  <!-- đơn sắc: không dùng đỏ -->
  <SolidColorBrush x:Key="CloseHoverFg"  Color="#FFFFFF"/>

  <!-- ── Checkbox, scrollbar, chọn chữ, tooltip ───────────────────── -->
  <SolidColorBrush x:Key="CheckBg"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CheckBorder"   Color="#3A3A3A"/>
  <SolidColorBrush x:Key="ScrollThumb"   Color="#C0C0C0"/>
  <SolidColorBrush x:Key="Selection"     Color="#1A1A1A"/>
  <SolidColorBrush x:Key="ToolTipBg"     Color="#FFFFFF"/>

  <!-- ── Thanh trạng thái kiểu statusline Neovim ──────────────────── -->
  <!-- Bar trắng, trạng thái nằm trong "badge" đen; khi bận badge chuyển xám accent. -->
  <SolidColorBrush x:Key="StatusBg"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="StatusBusyBg"  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="StatusFg"      Color="#000000"/>
  <SolidColorBrush x:Key="BadgeBg"       Color="#1A1A1A"/>
  <SolidColorBrush x:Key="BadgeBusyBg"   Color="#6E6E6E"/>
  <SolidColorBrush x:Key="BadgeFg"       Color="#FFFFFF"/>

  <!-- ── Hình học (đây là phần tạo ra cảm giác tiling) ────────────── -->
  <!-- RootPad + TileGap = 10px ở mép và 10px giữa hai ô, giống gaps_out/gaps_in của Hyprland. -->
  <Thickness    x:Key="RootPad">5</Thickness>
  <Thickness    x:Key="TileGap">5</Thickness>
  <Thickness    x:Key="TileBorder">2</Thickness>
  <Thickness    x:Key="BtnBorderThickness">1</Thickness>
  <CornerRadius x:Key="Radius">0</CornerRadius>
  <CornerRadius x:Key="CardRadius">0</CornerRadius>

  <!-- ── Thành phần nào hiển thị ──────────────────────────────────── -->
  <Visibility x:Key="ClassicChromeVis">Collapsed</Visibility>  <!-- activity bar + tiêu đề VS Code -->
  <Visibility x:Key="WaybarVis">Visible</Visibility>           <!-- workspace 1-4 + đồng hồ -->
</ResourceDictionary>
